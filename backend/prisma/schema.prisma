generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ IDENTITY / RBAC ============
// Roles as plain strings (ADMIN | ACCOUNTANT | SALES | SITE_STAFF) — SQLite's
// Prisma connector does not support native enums; validated via Zod in the API layer.

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String
  isActive     Boolean   @default(true)
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  materialRequests  MaterialRequest[] @relation("RequestedBy")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  meta       String?
  createdAt  DateTime @default(now())
}

// ============ NUMBERING ============

model DocumentCounter {
  id         String @id @default(cuid())
  docType    String
  year       Int
  month      Int
  lastNumber Int    @default(0)

  @@unique([docType, year, month])
}

// Singleton row (id always "default") holding the business's own letterhead
// details and per-document numbering prefixes, used on every generated PDF.
model CompanySettings {
  id                    String @id @default("default")
  name                  String @default("Staffgo Industrial Services")
  addressLine           String @default("Yanbu Industrial City")
  crNumber              String @default("7050031264")
  vatNumber             String @default("312999217900003")
  phone                 String @default("0500203896")
  logoUrl               String?
  currency              String @default("SAR")
  defaultVatRate        Float  @default(15)
  quotationPrefix       String @default("STG")
  salesOrderPrefix      String @default("SO")
  invoicePrefix         String @default("INV")
  deliveryNotePrefix    String @default("DN")
  purchaseOrderPrefix   String @default("PO")
  purchaseBillPrefix    String @default("BILL")
  materialRequestPrefix String @default("MR")
  clientInquiryPrefix    String @default("INQ")
  supplierInquiryPrefix  String @default("RFQ")
  supplierQuotationPrefix String @default("SQ")
  customerPoPrefix       String @default("CPO")
}

// ============ MASTERS ============

model Customer {
  id           String   @id @default(cuid())
  name         String
  trn          String?
  phone        String?
  email        String?
  address      String?
  city         String?
  country      String?
  creditTerms  String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contacts      CustomerContact[]
  interactions  CustomerInteraction[]
  quotations    Quotation[]
  salesOrders   SalesOrder[]
  invoices      Invoice[]
  deliveryNotes DeliveryNote[]
  projects      Project[]
  inquiries     ClientInquiry[]
  purchaseOrdersReceived CustomerPO[]
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  name       String
  role       String?
  phone      String?
  email      String?
}

model CustomerInteraction {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  type       String
  note       String
  date       DateTime @default(now())
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  trn           String?
  phone         String?
  email         String?
  address       String?
  paymentTerms  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rateHistory     SupplierRateHistory[]
  purchaseOrders  PurchaseOrder[]
  purchaseBills   PurchaseBill[]
  inquiriesSent   SupplierInquiry[]
  quotationsReceived SupplierQuotation[]
}

model SupplierRateHistory {
  id             String   @id @default(cuid())
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id])
  itemId         String
  item           Item     @relation(fields: [itemId], references: [id])
  rate           Float
  currency       String   @default("SAR")
  effectiveDate  DateTime @default(now())
}

model Item {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String
  category      String?
  baseUnit      String
  costingMethod String   @default("WEIGHTED_AVG")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  units               ItemUnit[]
  warehouseStocks     ItemWarehouseStock[]
  stockLedgerEntries  StockLedgerEntry[]
  supplierRates       SupplierRateHistory[]
  quotationLines      QuotationLine[]
  salesOrderLines     SalesOrderLine[]
  invoiceLines        InvoiceLine[]
  deliveryNoteLines   DeliveryNoteLine[]
  purchaseOrderLines  PurchaseOrderLine[]
  purchaseBillLines   PurchaseBillLine[]
  materialRequestLines MaterialRequestLine[]
}

model ItemUnit {
  id                   String @id @default(cuid())
  itemId               String
  item                 Item   @relation(fields: [itemId], references: [id])
  unitName             String
  conversionFactorToBase Float
}

model Warehouse {
  id      String @id @default(cuid())
  name    String
  type    String @default("WAREHOUSE") // WAREHOUSE | SITE
  address String?

  stocks               ItemWarehouseStock[]
  stockLedgerEntries   StockLedgerEntry[]
  deliveryNotes        DeliveryNote[]
  materialRequestsFrom MaterialRequest[] @relation("FromWarehouse")
}

model ItemWarehouseStock {
  id          String    @id @default(cuid())
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  qtyOnHand   Float     @default(0)
  reorderLevel Float    @default(0)

  @@unique([itemId, warehouseId])
}

model Employee {
  id            String   @id @default(cuid())
  name          String
  designation   String?
  phone         String?
  email         String?
  joinDate      DateTime?
  salary        Float?
  documentsPath String?
  createdAt     DateTime @default(now())

  user         User?
  laborEntries LaborEntry[]
  contracts    Contract[]
}

// ============ SALES ============
// Status fields are plain strings (see note above) — one of:
// DRAFT | SENT | PARTIAL | PAID | APPROVED | REJECTED | FULFILLED |
// CONVERTED | VOID | ACTIVE | COMPLETED | PENDING (validated via Zod per model).

model Quotation {
  id          String    @id @default(cuid())
  number      String    @unique
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  inquiryId   String?
  inquiry     ClientInquiry? @relation(fields: [inquiryId], references: [id])
  status      String @default("DRAFT")
  date        DateTime  @default(now())
  validUntil  DateTime?
  subtotal    Float     @default(0)
  vatAmount   Float     @default(0)
  total       Float     @default(0)

  // ---- Contracting-quote narrative sections (each *Items/Terms/Specs field is
  // newline-separated bullets; a leading "Label: text" segment is bolded in the PDF) ----
  projectTitle     String?  // large heading, e.g. "RENOVATION BUILDING PROJECT - RABIGH"
  location         String?
  validityText     String?  @default("30 days from quote date")
  leadTimeText     String?
  scopeIntro       String?
  scopeItems       String?
  furtherDetails   String?
  exclusionsIntro  String?
  exclusionsItems  String?
  technicalSpecs   String?
  termsText        String?  // "Terms and Conditions" bullets
  paymentTerms     String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lines           QuotationLine[]
  phases          QuotationPhase[]
  escalationLines QuotationEscalationLine[]
  salesOrders     SalesOrder[]
  shareLinks      ShareLink[] @relation("QuotationShare")
  customerPOs     CustomerPO[]
}

model QuotationLine {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  itemId      String?
  item        Item?     @relation(fields: [itemId], references: [id])
  description String?
  note        String?   // sub-line under description, e.g. "Quantity: 150 m²"
  qty         Float
  unit        String
  unitPrice   Float
  vatRate     Float     @default(15)
  lineTotal   Float
}

// "Project Phases" list under Technical Specifications, e.g. "Phase 1: Roof Sheet Removal & Installation"
model QuotationPhase {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  order       Int
  text        String
}

// "Price Escalation Table for Additional Quantities" — free-text unit price since
// values can be non-numeric (e.g. "To be quoted separately").
model QuotationEscalationLine {
  id             String    @id @default(cuid())
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id])
  order          Int
  description    String
  additionalPrice String
  notes          String?
}

model SalesOrder {
  id           String    @id @default(cuid())
  number       String    @unique
  quotationId  String?
  quotation    Quotation? @relation(fields: [quotationId], references: [id])
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id])
  status       String @default("DRAFT")
  date         DateTime  @default(now())
  subtotal     Float     @default(0)
  vatAmount    Float     @default(0)
  total        Float     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines         SalesOrderLine[]
  invoices      Invoice[]
  deliveryNotes DeliveryNote[]
}

model SalesOrderLine {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  itemId       String?
  item         Item?      @relation(fields: [itemId], references: [id])
  description  String?
  note         String?
  qty          Float
  unit         String
  unitPrice    Float
  vatRate      Float      @default(15)
  lineTotal    Float
}

model Invoice {
  id           String    @id @default(cuid())
  number       String    @unique
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id])
  invoiceDate  DateTime  @default(now())
  dueDate      DateTime?
  subtotal     Float     @default(0)
  vatAmount    Float     @default(0)
  total        Float     @default(0)
  amountPaid   Float     @default(0)
  status       String @default("DRAFT")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines      InvoiceLine[]
  payments   Payment[]
  shareLinks ShareLink[] @relation("InvoiceShare")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  itemId      String?
  item        Item?   @relation(fields: [itemId], references: [id])
  description String?
  note        String?
  qty         Float
  unit        String
  unitPrice   Float
  vatRate     Float   @default(15)
  lineTotal   Float
}

model DeliveryNote {
  id           String    @id @default(cuid())
  number       String    @unique
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  date         DateTime  @default(now())
  status       String @default("DRAFT")
  createdAt    DateTime  @default(now())

  lines DeliveryNoteLine[]
}

model DeliveryNoteLine {
  id             String       @id @default(cuid())
  deliveryNoteId String
  deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id])
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id])
  qty            Float
  unit           String
}

model Payment {
  id              String   @id @default(cuid())
  invoiceId       String?
  invoice         Invoice? @relation(fields: [invoiceId], references: [id])
  purchaseBillId  String?
  purchaseBill    PurchaseBill? @relation(fields: [purchaseBillId], references: [id])
  direction       String   // IN | OUT
  method          String?
  amount          Float
  date            DateTime @default(now())
  reference       String?
  createdAt       DateTime @default(now())
}

// ============ PURCHASING ============

model PurchaseOrder {
  id          String    @id @default(cuid())
  number      String    @unique
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  supplierQuotationId String?
  supplierQuotation   SupplierQuotation? @relation(fields: [supplierQuotationId], references: [id])
  status      String @default("DRAFT")
  date        DateTime  @default(now())
  subtotal    Float     @default(0)
  vatAmount   Float     @default(0)
  total       Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lines PurchaseOrderLine[]
  bills PurchaseBill[]
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  itemId          String?
  item            Item?         @relation(fields: [itemId], references: [id])
  description     String?
  note            String?
  qty             Float
  unit            String
  unitPrice       Float
  vatRate         Float         @default(15)
  lineTotal       Float
}

model PurchaseBill {
  id              String    @id @default(cuid())
  number          String    @unique
  supplierId      String
  supplier        Supplier  @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  warehouseId     String?
  billDate        DateTime  @default(now())
  dueDate         DateTime?
  subtotal        Float     @default(0)
  vatAmount       Float     @default(0)
  total           Float     @default(0)
  amountPaid      Float     @default(0)
  status          String @default("DRAFT")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lines    PurchaseBillLine[]
  payments Payment[]
}

model PurchaseBillLine {
  id             String       @id @default(cuid())
  purchaseBillId String
  purchaseBill   PurchaseBill @relation(fields: [purchaseBillId], references: [id])
  itemId         String?
  item           Item?        @relation(fields: [itemId], references: [id])
  description    String?
  note           String?
  qty            Float
  unit           String
  unitPrice      Float
  vatRate        Float        @default(15)
  lineTotal      Float
}

// ============ INVENTORY ============

model StockLedgerEntry {
  id          String    @id @default(cuid())
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  direction   String    // IN | OUT
  qty         Float
  unit        String
  unitCost    Float     @default(0)
  refType     String    // DELIVERY_NOTE | PURCHASE_BILL | MATERIAL_REQUEST | ADJUSTMENT
  refId       String?
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
}

model MaterialRequest {
  id            String    @id @default(cuid())
  number        String    @unique
  siteId        String
  site          Warehouse @relation("FromWarehouse", fields: [siteId], references: [id])
  requestedById String
  requestedBy   User      @relation("RequestedBy", fields: [requestedById], references: [id])
  status        String @default("PENDING")
  date          DateTime  @default(now())
  createdAt     DateTime  @default(now())

  lines MaterialRequestLine[]
}

model MaterialRequestLine {
  id                String          @id @default(cuid())
  materialRequestId String
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id])
  itemId            String?
  item              Item?           @relation(fields: [itemId], references: [id])
  itemName          String?         // free-text material name when not yet in the item catalog
  qtyRequested      Float
  qtyApproved       Float?
  unit              String
}

// ============ CONTRACTING / PROJECTS ============

model Project {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  contractValue Float?
  startDate     DateTime?
  endDate       DateTime?
  status        String @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  quotations     Quotation[]
  salesOrders    SalesOrder[]
  invoices       Invoice[]
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]
  boqs           Boq[]
  milestones     Milestone[]
  laborEntries   LaborEntry[]
  equipmentUsage EquipmentUsageLog[]
  clientInquiries ClientInquiry[]
}

model Boq {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  version   Int     @default(1)
  createdAt DateTime @default(now())

  lines BoqLine[]
}

model BoqLine {
  id          String @id @default(cuid())
  boqId       String
  boq         Boq    @relation(fields: [boqId], references: [id])
  description String
  unit        String
  qty         Float
  rate        Float
  amount      Float
  category    String?
}

model Milestone {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id])
  title           String
  dueDate         DateTime?
  status          String @default("PENDING")
  percentComplete Float     @default(0)
}

model Subcontractor {
  id      String @id @default(cuid())
  name    String
  trade   String?
  contact String?

  laborEntries LaborEntry[]
}

model LaborEntry {
  id               String         @id @default(cuid())
  projectId        String
  project          Project        @relation(fields: [projectId], references: [id])
  employeeId       String?
  employee         Employee?      @relation(fields: [employeeId], references: [id])
  subcontractorId  String?
  subcontractor    Subcontractor? @relation(fields: [subcontractorId], references: [id])
  date             DateTime       @default(now())
  quantity         Float          // hours or days
  rate             Float
  amount           Float
}

model Equipment {
  id           String @id @default(cuid())
  name         String
  type         String?
  ownedOrRented String @default("OWNED")

  usageLogs EquipmentUsageLog[]
}

model EquipmentUsageLog {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  dateFrom    DateTime
  dateTo      DateTime?
  cost        Float     @default(0)
}

// ============ FINANCE ============

model Expense {
  id             String   @id @default(cuid())
  category       String
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id])
  date           DateTime @default(now())
  amount         Float
  vatAmount      Float    @default(0)
  paidFrom       String   @default("BANK") // BANK | CASH
  description    String?
  attachmentPath String?
  createdAt      DateTime @default(now())
}

model LedgerAccount {
  id   String @id @default(cuid())
  name String
  type String // ASSET | LIABILITY | INCOME | EXPENSE | EQUITY

  entries LedgerEntry[]
}

model LedgerEntry {
  id        String        @id @default(cuid())
  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id])
  date      DateTime      @default(now())
  debit     Float         @default(0)
  credit    Float         @default(0)
  refType   String?
  refId     String?
  createdAt DateTime      @default(now())
}

model BankAccount {
  id       String @id @default(cuid())
  name     String
  bank     String?
  currency String @default("SAR")

  transactions BankTransaction[]
}

model BankTransaction {
  id              String      @id @default(cuid())
  bankAccountId   String
  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id])
  date            DateTime    @default(now())
  amount          Float
  description     String?
  reconciled      Boolean     @default(false)
  matchedPaymentId String?
}

// ============ ADMIN / DOCUMENTS ============

model Contract {
  id               String    @id @default(cuid())
  type             String    // EMPLOYMENT | CUSTOMER | SUPPLIER
  relatedCustomerId String?
  relatedSupplierId String?
  employeeId       String?
  employee         Employee? @relation(fields: [employeeId], references: [id])
  templateUsed     String?
  fileUrl          String?
  signedDate       DateTime?
  createdAt        DateTime  @default(now())
}

model DocumentTemplate {
  id       String @id @default(cuid())
  type     String @unique
  name     String
  htmlBody String
}

model ShareLink {
  id            String    @id @default(cuid())
  documentType  String
  quotationId   String?
  quotation     Quotation? @relation("QuotationShare", fields: [quotationId], references: [id])
  invoiceId     String?
  invoice       Invoice?   @relation("InvoiceShare", fields: [invoiceId], references: [id])
  slug          String    @unique
  token         String
  expiresAt     DateTime?
  viewCount     Int       @default(0)
  createdAt     DateTime  @default(now())
}

// ============ INQUIRIES & FOLLOW-UPS ============
// Tracks the pre-sales/pre-purchase paper trail that isn't otherwise captured
// by the transactional docs above: inquiries received from clients, RFQs sent
// to suppliers, quotations suppliers send back, and POs clients send us.
// Statuses are plain strings (see note near the top of this file).

model ClientInquiry {
  id           String    @id @default(cuid())
  number       String    @unique
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id])
  subject      String
  description  String?
  receivedDate DateTime  @default(now())
  status       String    @default("NEW") // NEW | QUOTED | CLOSED
  createdAt    DateTime  @default(now())

  quotations   Quotation[]
}

model SupplierInquiry {
  id          String    @id @default(cuid())
  number      String    @unique
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  subject     String
  description String?
  sentDate    DateTime  @default(now())
  status      String    @default("SENT") // SENT | QUOTED | CLOSED
  createdAt   DateTime  @default(now())

  quotationsReceived SupplierQuotation[]
}

model SupplierQuotation {
  id                String           @id @default(cuid())
  referenceNumber   String?          // supplier's own quote number, free text
  supplierId        String
  supplier          Supplier         @relation(fields: [supplierId], references: [id])
  supplierInquiryId String?
  supplierInquiry   SupplierInquiry? @relation(fields: [supplierInquiryId], references: [id])
  receivedDate      DateTime         @default(now())
  validUntil        DateTime?
  amount            Float
  currency          String           @default("SAR")
  notes             String?
  attachmentUrl     String?
  status            String           @default("RECEIVED") // RECEIVED | ACCEPTED | REJECTED
  createdAt         DateTime         @default(now())

  purchaseOrders    PurchaseOrder[]
}

model CustomerPO {
  id            String     @id @default(cuid())
  poNumber      String     // client's own PO number
  customerId    String
  customer      Customer   @relation(fields: [customerId], references: [id])
  quotationId   String?
  quotation     Quotation? @relation(fields: [quotationId], references: [id])
  receivedDate  DateTime   @default(now())
  amount        Float
  attachmentUrl String?
  status        String     @default("RECEIVED") // RECEIVED | FULFILLED
  createdAt     DateTime   @default(now())
}
